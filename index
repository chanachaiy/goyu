    <script>
        // Default initial dataset fallback
        let students = [
            { id: 1, studentId: "6813002001", name: "นายศุภกิตติ์ สีลาขาว", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 2, studentId: "6823002002", name: "นางสาวณกฤตตรา ลินโพธิ์ศาล", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 3, studentId: "6823002003", name: "นายครรชิต ดวงกันยา", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 4, studentId: "6913000004", name: "นางสาวพักตร์เพียงเพ็ญ ศรีโยธา", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 5, studentId: "6913000005", name: "นายรัชพล ศรีโยธา", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 6, studentId: "6913002006", name: "นายคำมัย เศษวิสัย", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 7, studentId: "6913002007", name: "นายอดิศักดิ์ เสมเหลา", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 8, studentId: "6913002008", name: "นายภานุพงษ์ เสียงเย็น", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 9, studentId: "6913002009", name: "นางสาวศรุตา สอนไตรแก้ว", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 },
            { id: 10, studentId: "6913002010", name: "นายธนันธร พุดสอยดาว", sub1: true, sub2: true, sub3: true, sub4: true, sub5: true, sub6: true, sub7: true, sub8: true, compCredit: 14, elecCredit: 8 }
        ];

        // Auth state variable
        let isAdminLoggedIn = false;
        let pendingAdminAction = null;

        const subjectKeys = [
            { key: 'sub1', code: 'ทช31002', name: 'ทักษะการเรียนรู้', type: 'compulsory' },
            { key: 'sub2', code: 'พค31001', name: 'คณิตศาสตร์', type: 'compulsory' },
            { key: 'sub3', code: 'สค31001', name: 'สังคมศึกษา', type: 'compulsory' },
            { key: 'sub4', code: 'อช31002', name: 'ช่องทางการขยายอาชีพ', type: 'compulsory' },
            { key: 'sub5', code: 'สค0200035', name: 'การเงินเพื่อชีวิต 3', type: 'elective' },
            { key: 'sub6', code: 'สค0200036', name: 'เกษตรธรรมชาติ', type: 'elective' },
            { key: 'sub7', code: 'สค0200037', name: 'ประวัติศาสตร์ชาติไทย', type: 'elective' },
            { key: 'sub8', code: 'สค0200038', name: 'การใช้พลังงานไฟฟ้า 3', type: 'elective' }
        ];

        let sortKey = 'id';
        let sortAsc = true;
        let barChartInstance = null;
        let doughnutChartInstance = null;
        let deleteTargetId = null;

        document.addEventListener('DOMContentLoaded', () => {
            initCharts();
            document.getElementById('printDate').innerText = new Date().toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' });
            
            // Update auth UI status initially
            updateAdminAuthUI();

            // Fetch initial data from Google Sheets if available
            syncDataFromSheet();
        });

        // Sync data from Google Sheet
        function syncDataFromSheet() {
            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler((data) => {
                        if (Array.isArray(data) && data.length > 0) {
                            students = data;
                            renderTable();
                            showToast("เชื่อมต่อดึงข้อมูลจาก Google Sheet สำเร็จแล้ว");
                        } else {
                            renderTable();
                        }
                    })
                    .withFailureHandler((err) => {
                        console.warn("Sheet read error:", err);
                        showToast("ข้อผิดพลาดในการโหลดข้อมูล: " + err.message, 4000);
                        renderTable();
                    })
                    .getStudentsData();
            } else {
                renderTable();
            }
        }

        function renderTable() {
            const tbody = document.getElementById('studentTableBody');
            const emptyState = document.getElementById('emptyState');
            tbody.innerHTML = '';

            const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
            const filterSubject = document.getElementById('subjectFilter').value;

            let filtered = students.filter(st => {
                const matchSearch = st.studentId.toLowerCase().includes(searchVal) || st.name.toLowerCase().includes(searchVal);
                const matchSubject = (filterSubject === 'all') ? true : st[filterSubject] === true;
                return matchSearch && matchSubject;
            });

            // Sorting
            filtered.sort((a, b) => {
                let valA = a[sortKey];
                let valB = b[sortKey];
                if (typeof valA === 'string') {
                    return sortAsc ? valA.localeCompare(valB, 'th') : valB.localeCompare(valA, 'th');
                }
                return sortAsc ? valA - valB : valB - valA;
            });

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
            }

            filtered.forEach((st, idx) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-sky-50/40 transition border-b border-slate-100";

                tr.innerHTML = `
                    <td class="py-3 px-3 text-center text-slate-500 text-xs">${idx + 1}</td>
                    <td class="py-3 px-4 font-mono font-medium text-slate-800 text-xs border-r border-slate-100">${st.studentId}</td>
                    <td class="py-3 px-4 font-medium text-slate-800 text-xs border-r border-slate-100">${st.name}</td>
                    
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub1, true)}</td>
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub2, true)}</td>
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub3, true)}</td>
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub4, true)}</td>
                    
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub5, false)}</td>
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub6, false)}</td>
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub7, false)}</td>
                    <td class="py-3 px-1 text-center border-r border-slate-100">${getSubBadge(st.sub8, false)}</td>
                    
                    <td class="py-3 px-2 text-center font-bold text-indigo-600 bg-indigo-50/30 border-r border-slate-100">${st.compCredit}</td>
                    <td class="py-3 px-2 text-center font-bold text-emerald-600 bg-emerald-50/30 border-r border-slate-100">${st.elecCredit}</td>
                    
                    <td class="py-3 px-4 text-center no-print">
                        <div class="flex items-center justify-center space-x-1.5">
                            <button onclick="editStudent(${st.id})" class="p-1.5 ${isAdminLoggedIn ? 'text-slate-400 hover:text-sky-600 hover:bg-sky-50' : 'text-slate-300 hover:text-amber-600'} rounded-lg transition" title="${isAdminLoggedIn ? 'แก้ไข' : 'ต้องเข้าสู่ระบบ Admin เพื่อแก้ไข'}">
                                <i class="fa-solid ${isAdminLoggedIn ? 'fa-pen-to-square' : 'fa-lock text-xs'}"></i>
                            </button>
                            <button onclick="askDeleteStudent(${st.id})" class="p-1.5 ${isAdminLoggedIn ? 'text-slate-400 hover:text-rose-600 hover:bg-rose-50' : 'text-slate-300 hover:text-amber-600'} rounded-lg transition" title="${isAdminLoggedIn ? 'ลบ' : 'ต้องเข้าสู่ระบบ Admin เพื่อลบ'}">
                                <i class="fa-solid ${isAdminLoggedIn ? 'fa-trash-can' : 'fa-lock text-xs'}"></i>
                            </button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            updateKPIs();
            updateCharts();
        }

        // Returns styled checkmark (✓) badge when course is selected
        function getSubBadge(val, isComp) {
            if (val) {
                return isComp ? `<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 text-[10px] font-bold shadow-sm"><i class="fa-solid fa-check"></i></span>`
                              : `<span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-bold shadow-sm"><i class="fa-solid fa-check"></i></span>`;
            }
            return `<span class="text-slate-300">-</span>`;
        }

        function updateKPIs() {
            const count = students.length;
            const totalComp = students.reduce((sum, s) => sum + (s.compCredit || 0), 0);
            const totalElec = students.reduce((sum, s) => sum + (s.elecCredit || 0), 0);

            document.getElementById('statTotalStudents').innerText = count.toLocaleString('th-TH');
            document.getElementById('statTotalComp').innerText = totalComp.toLocaleString('th-TH');
            document.getElementById('statTotalElec').innerText = totalElec.toLocaleString('th-TH');
            document.getElementById('statTotalCredits').innerText = (totalComp + totalElec).toLocaleString('th-TH');
        }

        function initCharts() {
            // Bar Chart
            const ctxBar = document.getElementById('subjectBarChart').getContext('2d');
            barChartInstance = new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: subjectKeys.map(s => s.code),
                    datasets: [{
                        label: 'จำนวนผู้ลงทะเบียน (คน)',
                        data: subjectKeys.map(() => 0),
                        backgroundColor: [
                            '#6366f1', '#6366f1', '#6366f1', '#6366f1',
                            '#10b981', '#10b981', '#10b981', '#10b981'
                        ],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 } }
                    }
                }
            });

            // Doughnut Chart
            const ctxDoughnut = document.getElementById('creditDoughnutChart').getContext('2d');
            doughnutChartInstance = new Chart(ctxDoughnut, {
                type: 'doughnut',
                data: {
                    labels: ['วิชาบังคับ (14 นก.)', 'วิชาเลือก (8 นก.)'],
                    datasets: [{
                        data: [0, 0],
                        backgroundColor: ['#6366f1', '#10b981']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        }

        function updateCharts() {
            if (!barChartInstance || !doughnutChartInstance) return;

            const subjectCounts = subjectKeys.map(s => {
                return students.filter(st => st[s.key] === true).length;
            });

            barChartInstance.data.datasets[0].data = subjectCounts;
            barChartInstance.update();

            const totalComp = students.reduce((sum, s) => sum + (s.compCredit || 0), 0);
            const totalElec = students.reduce((sum, s) => sum + (s.elecCredit || 0), 0);

            doughnutChartInstance.data.datasets[0].data = [totalComp, totalElec];
            doughnutChartInstance.update();
        }

        function openAddModal() {
            checkAdminPermission(() => {
                document.getElementById('modalTitle').innerHTML = `<i class="fa-solid fa-user-plus text-sky-400"></i><span>เพิ่มข้อมูลลงทะเบียนเรียน</span>`;
                document.getElementById('editIndex').value = "-1";
                document.getElementById('studentForm').reset();
                
                for (let i = 1; i <= 8; i++) {
                    document.getElementById('sub_' + subjectKeys[i-1].code).checked = true;
                }
                document.getElementById('modalCompulsoryCredits').value = 14;
                document.getElementById('modalElectiveCredits').value = 8;

                document.getElementById('studentModal').classList.remove('hidden');
            });
        }

        function editStudent(id) {
            checkAdminPermission(() => {
                const st = students.find(s => s.id === id);
                if (!st) return;

                document.getElementById('modalTitle').innerHTML = `<i class="fa-solid fa-user-pen text-sky-400"></i><span>แก้ไขข้อมูลนักศึกษา</span>`;
                document.getElementById('editIndex').value = id;
                document.getElementById('modalStudentId').value = st.studentId;
                document.getElementById('modalName').value = st.name;

                for (let i = 1; i <= 8; i++) {
                    const subObj = subjectKeys[i-1];
                    document.getElementById('sub_' + subObj.code).checked = st[subObj.key];
                }

                document.getElementById('modalCompulsoryCredits').value = st.compCredit;
                document.getElementById('modalElectiveCredits').value = st.elecCredit;

                document.getElementById('studentModal').classList.remove('hidden');
            });
        }

        function closeStudentModal() {
            document.getElementById('studentModal').classList.add('hidden');
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            if (!isAdminLoggedIn) {
                showToast("คุณต้องเข้าสู่ระบบ Admin ก่อนจึงจะทำรายการได้", 3000);
                closeStudentModal();
                openLoginModal();
                return;
            }

            const editId = parseInt(document.getElementById('editIndex').value);
            const studentId = document.getElementById('modalStudentId').value.trim();
            const name = document.getElementById('modalName').value.trim();

            const studentObj = {
                id: editId > 0 ? editId : 0,
                studentId: studentId,
                name: name,
                sub1: document.getElementById('sub_ทช31002').checked,
                sub2: document.getElementById('sub_พค31001').checked,
                sub3: document.getElementById('sub_สค31001').checked,
                sub4: document.getElementById('sub_อช31002').checked,
                sub5: document.getElementById('sub_สค0200035').checked,
                sub6: document.getElementById('sub_สค0200036').checked,
                sub7: document.getElementById('sub_สค0200037').checked,
                sub8: document.getElementById('sub_สค0200038').checked,
                compCredit: parseInt(document.getElementById('modalCompulsoryCredits').value) || 0,
                elecCredit: parseInt(document.getElementById('modalElectiveCredits').value) || 0
            };

            showToast("กำลังบันทึกข้อมูล...");

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler((res) => {
                        if (res.success) {
                            if (editId > 0) {
                                const idx = students.findIndex(s => s.id === editId);
                                if (idx > -1) students[idx] = res.student;
                            } else {
                                students.push(res.student);
                            }
                            renderTable();
                            closeStudentModal();
                            showToast("บันทึกข้อมูลสำเร็จเรียบร้อย");
                        } else {
                            showToast("เกิดข้อผิดพลาด: " + res.message);
                        }
                    })
                    .saveStudentData(studentObj);
            } else {
                // Local Fallback Execution
                if (editId > 0) {
                    const idx = students.findIndex(s => s.id === editId);
                    if (idx > -1) students[idx] = studentObj;
                } else {
                    studentObj.id = students.length > 0 ? Math.max(...students.map(s => s.id)) + 1 : 1;
                    students.push(studentObj);
                }
                renderTable();
                closeStudentModal();
                showToast("บันทึกข้อมูลสำเร็จแล้ว");
            }
        }

        function askDeleteStudent(id) {
            checkAdminPermission(() => {
                deleteTargetId = id;
                document.getElementById('confirmModalActionBtn').onclick = () => performDeleteStudent();
                document.getElementById('confirmModal').classList.remove('hidden');
            });
        }

        function closeConfirmModal() {
            document.getElementById('confirmModal').classList.add('hidden');
            deleteTargetId = null;
        }

        function performDeleteStudent() {
            if (!deleteTargetId) return;
            if (!isAdminLoggedIn) {
                showToast("คุณต้องเข้าสู่ระบบ Admin ก่อนจึงจะลบข้อมูลได้", 3000);
                closeConfirmModal();
                openLoginModal();
                return;
            }

            showToast("กำลังลบข้อมูล...");
            closeConfirmModal();

            if (typeof google !== 'undefined' && google.script && google.script.run) {
                google.script.run
                    .withSuccessHandler((res) => {
                        if (res.success) {
                            students = students.filter(s => s.id !== deleteTargetId);
                            renderTable();
                            showToast("ลบรายการลงทะเบียนสำเร็จ");
                        } else {
                            showToast("ไม่สามารถลบได้: " + res.message);
                        }
                    })
                    .deleteStudentData(deleteTargetId);
            } else {
                students = students.filter(s => s.id !== deleteTargetId);
                renderTable();
                showToast("ลบรายการเรียบร้อยแล้ว");
            }
        }

        function exportToCSV() {
            let csvContent = "\uFEFF"; // UTF-8 BOM for Thai text support in Excel
            csvContent += "ลำดับ,รหัสนักศึกษา,ชื่อ - นามสกุล,ทช31002,พค31001,สค31001,อช31002,สค0200035,สค0200036,สค0200037,สค0200038,หน่วยกิตบังคับ,หน่วยกิตเลือก\n";

            students.forEach((st, idx) => {
                const row = [
                    idx + 1,
                    `"${st.studentId}"`,
                    `"${st.name}"`,
                    st.sub1 ? "✓" : "-",
                    st.sub2 ? "✓" : "-",
                    st.sub3 ? "✓" : "-",
                    st.sub4 ? "✓" : "-",
                    st.sub5 ? "✓" : "-",
                    st.sub6 ? "✓" : "-",
                    st.sub7 ? "✓" : "-",
                    st.sub8 ? "✓" : "-",
                    st.compCredit,
                    st.elecCredit
                ];
                csvContent += row.join(",") + "\n";
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `รายงานสรุปการลงทะเบียนเรียน_2569_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("ส่งออกไฟล์ CSV สำเร็จแล้ว");
        }

        function handleSearch() {
            renderTable();
        }

        function applyFilters() {
            renderTable();
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('subjectFilter').value = 'all';
            renderTable();
        }

        function sortData(key) {
            if (sortKey === key) {
                sortAsc = !sortAsc;
            } else {
                sortKey = key;
                sortAsc = true;
            }
            renderTable();
        }

        function showToast(msg, duration = 3000) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, duration);
        }
    </script>
</body>
